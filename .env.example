DD_API_KEY=your_datadog_api_key
DD_SITE=datadoghq.com
DD_ENV=local
DD_SERVICE=crud-observability-demo
DD_VERSION=1.0.0
DD_RUM_APPLICATION_ID=your_datadog_rum_application_id
DD_RUM_CLIENT_TOKEN=your_datadog_rum_client_token
DD_RUM_SITE=datadoghq.com
DD_RUM_SERVICE=crud-observability-demo-frontend
DD_RUM_ENV=local
DD_RUM_VERSION=1.0.0
DD_RUM_SESSION_SAMPLE_RATE=100
DD_RUM_SESSION_REPLAY_SAMPLE_RATE=20
DD_RUM_TRACK_RESOURCES=true
DD_RUM_TRACK_USER_INTERACTIONS=true
DD_RUM_TRACK_LONG_TASKS=true
DD_RUM_DEFAULT_PRIVACY_LEVEL=allow
DD_RUM_ALLOWED_TRACING_PATHS=/api/
DD_RUM_TEAM=your-team
DD_RUM_APPLICATION=your-application-tag
LOG_LEVEL=INFO
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
LOADGEN_INTERVAL_SECONDS=2
LOADGEN_TIMEOUT_SECONDS=10
